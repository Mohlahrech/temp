<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Partner Creation Wizard Form View -->
    <record id="partner_creation_wizard_form" model="ir.ui.view">
        <field name="name">partner.creation.wizard.form</field>
        <field name="model">partner.creation.wizard</field>
        <field name="arch" type="xml">
            <form string="Demander la création d'un partenaire">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="name" placeholder="Nom du partenaire à créer..."/>
                    <field name="phone" placeholder="Numéro de téléphone (optionnel)..."/>
                    <field name="email" placeholder="Adresse email (optionnel)..."/>
                    <field name="city" placeholder="Ville (optionnel)..."/>
                    <field name="notes" placeholder="Informations supplémentaires..."/>
                </group>
                <footer>
                    <button name="action_submit_request" string="Soumettre la demande" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Partner Creation Wizard Action -->
    <record id="partner_creation_wizard_action" model="ir.actions.act_window">
        <field name="name">Demander création partenaire</field>
        <field name="res_model">partner.creation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_task_id': active_id}</field>
        <field name="view_id" ref="partner_creation_wizard_form"/>
    </record>

    <!-- Temp Partner Tree View -->
    <record id="temp_partner_tree_view" model="ir.ui.view">
        <field name="name">temp.partner.tree</field>
        <field name="model">temp.partner</field>
        <field name="arch" type="xml">
            <tree string="Demandes de création de partenaires" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                <field name="request_date"/>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <field name="state"/>
                <field name="partner_id" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
            </tree>
        </field>
    </record>

    <!-- Temp Partner Form View -->
    <record id="temp_partner_form_view" model="ir.ui.view">
        <field name="name">temp.partner.form</field>
        <field name="model">temp.partner</field>
        <field name="arch" type="xml">
            <form string="Demande de création de partenaire">
                <header>
                    <button name="action_approve" string="Approuver" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_reject" string="Rejeter" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informations de base">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="city"/>
                        </group>
                        <group string="Détails de la demande">
                            <field name="requested_by"/>
                            <field name="request_date"/>
                            <field name="task_id"/>
                            <field name="partner_id" attrs="{'invisible': [('partner_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Notes supplémentaires" attrs="{'invisible': [('notes', '=', False)]}">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Temp Partner Action -->
    <record id="temp_partner_action" model="ir.actions.act_window">
        <field name="name">Demandes de création</field>
        <field name="res_model">temp.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune demande trouvée!</p>
            <p>Les demandes de création de partenaires sont soumises depuis les formulaires de tâches FSM.</p>
        </field>
    </record>

    <!-- Menu for Temp Partners - Only for managers -->
    <menuitem id="temp_partner_menu"
              name="Demandes création contact"
              parent="industry_fsm.fsm_menu_alerte"
              action="temp_partner_action"
              groups="industry_fsm.group_fsm_manager"
              sequence="60"/>

</odoo>
