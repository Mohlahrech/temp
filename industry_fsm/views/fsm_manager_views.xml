<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ============================================
             FSM MANAGER GLOBAL ACTIONS
             ============================================ -->

        <!-- All Tasks - Global View -->
        <record id="project_task_action_manager_all" model="ir.actions.act_window">
            <field name="name">Calendrier des visites</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">calendar,gantt,tree,kanban,form,map,pivot,graph,activity</field>
            <field name="domain">[('is_fsm', '=', True)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p>
                <p>
                    This is a global view showing all FSM tasks across all users and projects.
                    Use this view to get a complete overview of all field service operations.
                </p>
            </field>
        </record>

        <!-- All Tasks - Calendar View -->
        <record id="project_task_action_manager_all_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="project_task_view_calendar_fsm"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- All Tasks - Gantt View -->
        <record id="project_task_action_manager_all_view_gantt" model="ir.actions.act_window.view">
            <field name="sequence" eval="20"/>
            <field name="view_mode">gantt</field>
            <field name="view_id" ref="project_task_view_gantt"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- All Tasks - Tree View -->
        <record id="project_task_action_manager_all_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="30"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="project_task_view_list_fsm"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- All Tasks - Kanban View -->
        <record id="project_task_action_manager_all_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="40"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="project_task_view_kanban_fsm_all"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- All Tasks - Map View -->
        <record id="project_task_action_manager_all_view_map" model="ir.actions.act_window.view">
            <field name="sequence" eval="50"/>
            <field name="view_mode">map</field>
            <field name="view_id" ref="project_task_map_view"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- All Tasks - Form View -->
        <record id="project_task_action_manager_all_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="60"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="project.view_task_form2"/>
            <field name="act_window_id" ref="project_task_action_manager_all"/>
        </record>

        <!-- Planning/Gantt View - Global -->
        <record id="project_task_action_manager_planning" model="ir.actions.act_window">
            <field name="name">Planning</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">gantt,calendar,tree,kanban,form</field>
            <field name="domain">[('is_fsm', '=', True), ('planned_date_begin', '!=', False)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No planned tasks found.
                </p>
                <p>
                    This view shows all planned FSM tasks across all users and projects.
                    Use this to manage team scheduling and resource allocation.
                </p>
            </field>
        </record>

        <!-- Planning - Gantt View -->
        <record id="project_task_action_manager_planning_view_gantt" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">gantt</field>
            <field name="view_id" ref="project_task_view_gantt"/>
            <field name="act_window_id" ref="project_task_action_manager_planning"/>
        </record>

        <!-- Planning - Calendar View -->
        <record id="project_task_action_manager_planning_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="20"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="project_task_view_calendar_fsm"/>
            <field name="act_window_id" ref="project_task_action_manager_planning"/>
        </record>

        <!-- Planning - Tree View -->
        <record id="project_task_action_manager_planning_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="30"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="project_task_view_list_fsm"/>
            <field name="act_window_id" ref="project_task_action_manager_planning"/>
        </record>

        <!-- Planning - Kanban View -->
        <record id="project_task_action_manager_planning_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="40"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="project_task_view_kanban_fsm_all"/>
            <field name="act_window_id" ref="project_task_action_manager_planning"/>
        </record>

        <!-- Planning - Form View -->
        <record id="project_task_action_manager_planning_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="50"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="project.view_task_form2"/>
            <field name="act_window_id" ref="project_task_action_manager_planning"/>
        </record>

        <!-- All Projects - Global View -->
        <record id="project_project_action_manager_all" model="ir.actions.act_window">
            <field name="name">All Projects</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">tree,kanban,form,graph,pivot,calendar,activity</field>
            <field name="domain">[('is_fsm', '=', True)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No FSM projects found. Let's create one!
                </p>
                <p>
                    This view shows all FSM projects. Use this to manage all field service projects.
                </p>
            </field>
        </record>

        <!-- All Partners/Customers - Global View -->
        <record id="res_partner_action_manager_all" model="ir.actions.act_window">
            <field name="name">All Customers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form,activity</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No customers found. Let's create one!
                </p>
                <p>
                    This view shows all customers/partners. Use this to manage all customer relationships.
                </p>
            </field>
        </record>

        <!-- Simple Tree View for Users (without problematic fields) -->
        <record id="res_users_view_tree_manager" model="ir.ui.view">
            <field name="name">res.users.tree.manager</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <tree string="Users">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="active"/>
                    <field name="groups_id" widget="many2many_tags"/>
                </tree>
            </field>
        </record>


        <!-- ============================================
             FSM MANAGER MENU STRUCTURE
             ============================================ -->

        <!-- Top-Level Manager Menu -->
        <menuitem id="fsm_menu_manager_root"
                  name="Manager"
                  sequence="50"
                  web_icon="industry_fsm,static/description/icon.png"
                  groups="industry_fsm.group_fsm_manager"/>

        <!-- All Tasks Submenu -->
        <menuitem id="fsm_menu_manager_visites"
                  name="Visites"
                  sequence="10"
                  parent="fsm_menu_manager_root"
                  groups="industry_fsm.group_fsm_manager"/>

        <menuitem id="fsm_menu_manager_all_tasks"
                  name="Calendrier des visites"
                  sequence="10"
                  action="project_task_action_manager_all"
                  parent="fsm_menu_manager_visites"
                  groups="industry_fsm.group_fsm_manager"/>




        <!-- Statistics Submenu -->
        <menuitem id="fsm_menu_manager_statistics"
                  name="Dashboards"
                  sequence="60"
                  action="industry_fsm.fsm_manager_statistics_action"
                  parent="fsm_menu_manager_root"
                  groups="industry_fsm.group_fsm_manager"/>

        <!-- Task Analysis Submenu -->
        <menuitem id="fsm_menu_manager_task_analysis"
                  name="Analyses"
                  sequence="70"
                  action="industry_fsm.project_task_user_action_report_fsm"
                  parent="fsm_menu_manager_root"
                  groups="industry_fsm.group_fsm_manager"/>

        <!-- All Visits Submenu -->
        <menuitem id="fsm_menu_manager_all_visits"
                  name="Liste de toutes les visites"
                  sequence="0"
                  action="industry_fsm.project_task_action_all_fsm"
                  parent="fsm_menu_manager_visites"
                  groups="industry_fsm.group_fsm_manager"/>

    </data>
</odoo>
