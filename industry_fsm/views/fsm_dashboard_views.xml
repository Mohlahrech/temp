<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FSM Dashboard Kanban View -->
    <record id="fsm_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">fsm.dashboard.kanban</field>
        <field name="model">fsm.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_fsm_dashboard_kanban" create="false" edit="false" delete="false">
                <field name="user_id"/>
                <field name="user_name"/>
                <field name="total_visits"/>
                <field name="missed_visits"/>
                <field name="today_visits"/>
                <field name="completed_visits"/>
                <field name="pending_visits"/>
                <field name="completion_rate"/>
                <!-- Header with action buttons -->
                <header>
                    <button name="refresh_dashboard_data" type="object" class="btn-primary">
                        <i class="fa fa-refresh"/> Refresh Data
                    </button>
                    <button name="%(fsm_dashboard_wizard_action)d" type="action" class="btn-secondary ms-2">
                        <i class="fa fa-users"/> Select Users
                    </button>
                </header>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px; padding: 20px; margin: 10px; min-height: 280px;">
                            <!-- User Header -->
                            <div class="o_kanban_record_top" style="margin-bottom: 15px;">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 18px; color: white;">
                                        <i class="fa fa-user-circle" style="margin-right: 8px;"></i>
                                        <t t-esc="record.user_name.value"/>
                                    </strong>
                                </div>
                            </div>
                            
                            <!-- Statistics Grid -->
                            <div class="row" style="margin: 0;">
                                <!-- Total Visits -->
                                <div class="col-6" style="padding: 5px;">
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 10px; padding: 15px; text-align: center;">
                                        <i class="fa fa-calendar-check-o" style="font-size: 24px; margin-bottom: 5px;"></i>
                                        <div style="font-size: 24px; font-weight: bold;">
                                            <t t-esc="record.total_visits.value"/>
                                        </div>
                                        <div style="font-size: 12px; opacity: 0.9;">Total Visits</div>
                                    </div>
                                </div>
                                
                                <!-- Today's Visits -->
                                <div class="col-6" style="padding: 5px;">
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 10px; padding: 15px; text-align: center;">
                                        <i class="fa fa-clock-o" style="font-size: 24px; margin-bottom: 5px;"></i>
                                        <div style="font-size: 24px; font-weight: bold;">
                                            <t t-esc="record.today_visits.value"/>
                                        </div>
                                        <div style="font-size: 12px; opacity: 0.9;">Today's Visits</div>
                                    </div>
                                </div>
                                
                                <!-- Completed Visits -->
                                <div class="col-6" style="padding: 5px;">
                                    <div style="background: rgba(76, 175, 80, 0.3); border-radius: 10px; padding: 15px; text-align: center;">
                                        <i class="fa fa-check-circle" style="font-size: 24px; margin-bottom: 5px;"></i>
                                        <div style="font-size: 24px; font-weight: bold;">
                                            <t t-esc="record.completed_visits.value"/>
                                        </div>
                                        <div style="font-size: 12px; opacity: 0.9;">Completed</div>
                                    </div>
                                </div>
                                
                                <!-- Missed Visits -->
                                <div class="col-6" style="padding: 5px;">
                                    <div style="background: rgba(244, 67, 54, 0.3); border-radius: 10px; padding: 15px; text-align: center;">
                                        <i class="fa fa-exclamation-triangle" style="font-size: 24px; margin-bottom: 5px;"></i>
                                        <div style="font-size: 24px; font-weight: bold;">
                                            <t t-esc="record.missed_visits.value"/>
                                        </div>
                                        <div style="font-size: 12px; opacity: 0.9;">Manquées</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Completion Rate -->
                            <div style="margin-top: 15px; text-align: center; background: rgba(255,255,255,0.1); border-radius: 10px; padding: 10px;">
                                <div style="font-size: 14px; margin-bottom: 5px;">Taux de completion</div>
                                <div style="font-size: 20px; font-weight: bold;">
                                    <t t-esc="record.completion_rate.value"/>%
                                </div>
                                <!-- Progress Bar -->
                                <div style="background: rgba(255,255,255,0.3); border-radius: 10px; height: 8px; margin-top: 8px; overflow: hidden;">
                                    <div t-attf-style="background: #4CAF50; height: 100%; width: {{record.completion_rate.value}}%; transition: width 0.3s ease;"></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- FSM Dashboard Tree View (fallback) -->
    <record id="fsm_dashboard_tree_view" model="ir.ui.view">
        <field name="name">fsm.dashboard.tree</field>
        <field name="model">fsm.dashboard</field>
        <field name="arch" type="xml">
            <tree string="FSM Dashboard" create="false" edit="false" delete="false">
                <field name="user_name"/>
                <field name="total_visits"/>
                <field name="today_visits"/>
                <field name="completed_visits"/>
                <field name="missed_visits"/>
                <field name="completion_rate" widget="percentage"/>
            </tree>
        </field>
    </record>

    <!-- FSM Dashboard Search View -->
    <record id="fsm_dashboard_search_view" model="ir.ui.view">
        <field name="name">fsm.dashboard.search</field>
        <field name="model">fsm.dashboard</field>
        <field name="arch" type="xml">
            <search string="FSM Dashboard">
                <field name="user_name" string="User"/>
                <field name="user_id" string="User"/>
                <filter string="My Dashboard" name="my_dashboard" 
                        domain="[('user_id', '=', uid)]"/>
                <filter string="All Users" name="all_users" 
                        domain="[]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FSM Dashboard Action -->
    <record id="fsm_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tableau de board</field>
        <field name="res_model">fsm.dashboard</field>
        <field name="view_mode">kanban,tree</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{
            'create_dashboard_records': True,
            'search_default_my_dashboard': 1
        }</field>
        <field name="search_view_id" ref="fsm_dashboard_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Votre tableau de board
            </p>
            <p>
                View your visit statistics including total visits, completed visits, missed visits, and today's scheduled visits.
            </p>
            <p>
                Use the filters above to view other users' dashboards or see all users at once.
            </p>
            <p>
                <button name="create_dashboard_records" type="object" class="btn-primary">
                    Create Dashboard Records
                </button>
            </p>
        </field>
    </record>

    <!-- FSM Dashboard Action View Kanban -->
    <record id="fsm_dashboard_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="fsm_dashboard_kanban_view"/>
        <field name="act_window_id" ref="fsm_dashboard_action"/>
    </record>

    <!-- FSM Dashboard Action View Tree -->
    <record id="fsm_dashboard_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="fsm_dashboard_tree_view"/>
        <field name="act_window_id" ref="fsm_dashboard_action"/>
    </record>

    <!-- FSM Manager Statistics Action (KPI Dashboard) -->
    <record id="fsm_manager_statistics_action" model="ir.actions.act_window">
        <field name="name">Tableau de Bord KPI</field>
        <field name="res_model">fsm.kpi.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context" eval="{}"/>
        <field name="search_view_id" ref="fsm_kpi_dashboard_search_view_manager"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tableau de Bord KPI FSM
            </p>
        </field>
    </record>

    <!-- FSM Manager Statistics Action View Kanban -->
    <record id="fsm_manager_statistics_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="fsm_kpi_dashboard_kanban_view"/>
        <field name="act_window_id" ref="fsm_manager_statistics_action"/>
    </record>

</odoo>
